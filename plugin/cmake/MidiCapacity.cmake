# JUCE 8.0.8 owns the MIDI buffers passed to processBlock. Reserve output at
# device/plugin preparation, not inside the callback. Leave the JUCE checkout intact.
include("${CMAKE_CURRENT_LIST_DIR}/PreparedMidiLayout.cmake")
loopforge_verify_prepared_midi_layout("${JUCE_MODULES_DIR}/juce_audio_basics/midi")
add_library(loopforge_prepared_midi INTERFACE)
target_compile_definitions(loopforge_prepared_midi INTERFACE LOOPFORGE_VERIFIED_MIDI_LAYOUT=1)
function(loopforge_write_copy path content)
 file(WRITE "${path}.tmp" "${content}")
 configure_file("${path}.tmp" "${path}" COPYONLY)
 file(REMOVE "${path}.tmp")
endfunction()
set(rt_dir "${CMAKE_CURRENT_BINARY_DIR}/juce-midi-capacity")
file(MAKE_DIRECTORY "${rt_dir}")
set(vst_source "${JUCE_MODULES_DIR}/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp")
file(READ "${vst_source}" vst)
string(FIND "${vst}" "midiBuffer.ensureSize (2048);" anchor)
if(anchor EQUAL -1)
 message(FATAL_ERROR "JUCE VST3 MIDI preparation changed; review MidiCapacity.cmake")
endif()
string(REPLACE "midiBuffer.ensureSize (2048);" "midiBuffer.ensureSize (32768);" vst "${vst}")
loopforge_write_copy("${rt_dir}/VST3.cpp" "${vst}")
set_source_files_properties("${vst_source}" PROPERTIES HEADER_FILE_ONLY TRUE)
target_sources(LoopForge_VST3 PRIVATE "${rt_dir}/VST3.cpp")
set(utils_source "${JUCE_MODULES_DIR}/juce_audio_utils/juce_audio_utils.cpp")
file(READ "${JUCE_MODULES_DIR}/juce_audio_utils/players/juce_AudioProcessorPlayer.cpp" player)
string(FIND "${player}" "messageCollector.reset (sampleRate);" anchor)
if(anchor EQUAL -1)
 message(FATAL_ERROR "JUCE device preparation changed; review MidiCapacity.cmake")
endif()
string(REPLACE "messageCollector.reset (sampleRate);" "incomingMidi.ensureSize (32768);\n    messageCollector.reset (sampleRate);" player "${player}")
loopforge_write_copy("${rt_dir}/Player.cpp" "${player}")
file(READ "${utils_source}" utils)
string(REPLACE "\"players/juce_AudioProcessorPlayer.cpp\"" "\"${rt_dir}/Player.cpp\"" utils "${utils}")
loopforge_write_copy("${rt_dir}/AudioUtils.cpp" "${utils}")
set_source_files_properties("${utils_source}" PROPERTIES HEADER_FILE_ONLY TRUE)
target_sources(LoopForge PRIVATE "${rt_dir}/AudioUtils.cpp")
target_include_directories(LoopForge PRIVATE "${JUCE_MODULES_DIR}/juce_audio_utils")
