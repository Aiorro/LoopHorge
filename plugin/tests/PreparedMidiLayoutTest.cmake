# Verify the real guard, including platform checkout line endings and both drift inputs.
set(fixture "${CMAKE_CURRENT_BINARY_DIR}/prepared-midi-layout-fixture")
file(MAKE_DIRECTORY "${fixture}")
foreach(name IN ITEMS juce_MidiBuffer.h juce_MidiBuffer.cpp)
 file(READ "${JUCE_MIDI_DIR}/${name}" source)
 string(REPLACE "\r\n" "\n" source "${source}")
 file(WRITE "${fixture}/${name}" "${source}")
endforeach()
file(WRITE "${fixture}/check.cmake" "include([==[${LAYOUT_MODULE}]==])\nloopforge_verify_prepared_midi_layout([==[${fixture}]==])\n")
function(check_guard should_pass)
 execute_process(COMMAND "${CMAKE_COMMAND}" -P "${fixture}/check.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
 if(should_pass)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Compatible layout rejected: ${output}${errors}")
  endif()
 else()
  if(result EQUAL 0 OR NOT errors MATCHES "JUCE prepared MIDI layout changed")
   message(FATAL_ERROR "Layout drift did not fail with the intended guard: ${output}${errors}")
  endif()
 endif()
endfunction()
check_guard(TRUE)
foreach(name IN ITEMS juce_MidiBuffer.h juce_MidiBuffer.cpp)
 file(READ "${fixture}/${name}" source)
 string(REPLACE "\n" "\r\n" source "${source}")
 file(WRITE "${fixture}/${name}" "${source}")
endforeach()
check_guard(TRUE)
foreach(name IN ITEMS juce_MidiBuffer.h juce_MidiBuffer.cpp)
 file(READ "${fixture}/${name}" original)
 file(APPEND "${fixture}/${name}" "\n// simulated source drift\n")
 check_guard(FALSE)
 file(WRITE "${fixture}/${name}" "${original}")
endforeach()
# An ordinary incremental build must rerun the verifier, not merely explicit configure.
file(MAKE_DIRECTORY "${fixture}/project")
file(WRITE "${fixture}/project/CMakeLists.txt" "cmake_minimum_required(VERSION 3.22)\nproject(LayoutDependency NONE)\ninclude([==[${LAYOUT_MODULE}]==])\nloopforge_verify_prepared_midi_layout([==[${fixture}]==])\nadd_custom_target(checked ALL COMMAND [==[${CMAKE_COMMAND}]==] -E echo checked)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}/project" -B "${fixture}/build"
 -G "${BUILD_GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${BUILD_MAKE_PROGRAM}"
 RESULT_VARIABLE configured OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT configured EQUAL 0)
 message(FATAL_ERROR "Initial dependency fixture configure failed: ${output}${errors}")
endif()
function(check_incremental should_pass)
 execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --config Release
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
 if(should_pass)
  if(NOT result EQUAL 0)
   message(FATAL_ERROR "Valid incremental layout build failed: ${output}${errors}")
  endif()
 else()
  if(result EQUAL 0 OR NOT "${output}${errors}" MATCHES "JUCE prepared MIDI layout changed")
   message(FATAL_ERROR "Incremental layout drift bypassed the guard: ${output}${errors}")
  endif()
 endif()
endfunction()
check_incremental(TRUE)
foreach(name IN ITEMS juce_MidiBuffer.h juce_MidiBuffer.cpp)
 file(READ "${fixture}/${name}" original)
 file(APPEND "${fixture}/${name}" "\n// incremental source drift\n")
 check_incremental(FALSE)
 file(WRITE "${fixture}/${name}" "${original}")
 check_incremental(TRUE)
endforeach()
file(REMOVE_RECURSE "${fixture}")
message(STATUS "Prepared MIDI layout guard: LF/CRLF accepted; explicit and incremental header/implementation drift rejected")
